{
  "schema_version": 1,
  "phase": "speech",
  "method": "derpp",
  "seed": 42,
  "domains": [
    "en",
    "zh"
  ],
  "model": {
    "modality": "audio",
    "name": "openai/whisper-medium",
    "revision": "abdf7c39ab9d0397620ccaea8974cc764cd0953e",
    "pretrained": true,
    "gradient_checkpointing": true
  },
  "data": {
    "modality": "audio",
    "root": "data",
    "text_dir": "processed/text",
    "speech_dir": "processed/speech_v3",
    "test_labels": "locked/taukadial/test_labels.csv"
  },
  "training": {
    "source_epochs": 5,
    "target_epochs": 5,
    "batch_size": 2,
    "lr": 3e-05,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "max_length": 256,
    "precision": "float32",
    "checkpoint_every": 500,
    "source_selection": "source_validation_accuracy",
    "target_selection": "domain_averaged_validation_accuracy"
  },
  "updates": {
    "policy": "full",
    "rank": 8,
    "alpha": 16,
    "dropout": 0.05,
    "placement": "all"
  },
  "memory": {
    "capacity": 128,
    "replay_batch_size": 2,
    "alpha": 0.5,
    "beta": 0.5,
    "sparse_frequency": 100,
    "sparse_batch_size": 100,
    "sparse_microbatch_size": 2
  },
  "local_adaptation": {
    "neighbors": 32,
    "steps": 30,
    "lr": 0.001,
    "anchor_strength": 0.001,
    "microbatch_size": 2
  },
  "timescales": {
    "head_interval": 1,
    "encoder_interval": 1
  },
  "evaluation": {
    "split": "validation",
    "batch_size": 4,
    "bootstrap_samples": 1000,
    "confidence": 0.95
  },
  "runtime": {
    "device": "cuda",
    "num_threads": 4
  },
  "protocol": {
    "common_supervised_source_checkpoint": true,
    "memory_admission": "once_per_unique_training_example_on_first_epoch",
    "speech_aggregation": "window_mean_then_equal_recording_mean_per_participant"
  }
}
